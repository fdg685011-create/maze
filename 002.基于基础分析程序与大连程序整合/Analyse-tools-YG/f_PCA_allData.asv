function f_PCA_allData(data, fs, window_length, refs)
    % data: 时间序列 * 通道数 (2D matrix)
    % fs: 采样率
    % window_length: 窗口长度（秒）
    % refs: 打标区间 (2D array, 每行是一个试次，第一列是开始时刻，第二列是结束时刻，第三列是类别标签)

    % 数据预处理
    [num_samples, num_channels] = size(data);
    window_samples = round(window_length * fs); % 计算窗口长度对应的样本数
    num_windows = floor(num_samples / window_samples); % 计算窗口数量

    % 滑窗并计算每个窗口的平均值
    windowed_data = zeros(num_windows, num_channels);
    for i = 1:num_windows
        start_idx = (i-1) * window_samples + 1;
        end_idx = i * window_samples;
        windowed_data(i, :) = mean(data(start_idx:end_idx, :), 1); % 对每个窗口取平均值
    end

    % 对滑窗后的数据进行PCA降维
    [coeff, score, ~] = pca(windowed_data); % coeff是主成分系数，score是降维后的数据
    reduced_data = score(:, 1:3); % 降至三维

    % 绘制散点图
    figure;
    hold on;

    % 自动检索 refs 中的类别标签
    unique_labels = unique(refs(:, 3)); % 获取唯一的类别标签
    colors = [1 0 0;1 1 0;0 1 0];

    % 遍历所有窗口点
    for i = 1:num_windows
        % 计算当前窗口的时间范围
        window_start_time = (i-1) * window_length;
        window_end_time = i * window_length;

        % 判断当前窗口是否在打标区间内
        in_ref = false;
        label = -1; % 默认类别标签为 -1（区间外）
        for j = 1:size(refs, 1)
            if window_start_time >= refs(j, 1) && window_end_time <= refs(j, 2)
                in_ref = true;
                label = refs(j, 3); % 获取类别标签
                break;
            end
        end

        % 根据类别标签选择颜色
        if label == -1
            % 区间外用蓝色
            scatter3(reduced_data(i, 1), reduced_data(i, 2), reduced_data(i, 3), 50, 'b', 'filled');
        else
            % 区间内根据类别标签选择颜色
            color_idx = find(unique_labels == label); % 找到类别标签对应的颜色索引
            scatter3(reduced_data(i, 1), reduced_data(i, 2), reduced_data(i, 3), 50, colors(color_idx, :), 'filled');
        end
    end

    % 设置图形属性
    xlabel('PC1');
    ylabel('PC2');
    zlabel('PC3');
    title('PCA降维结果（滑窗平均值）');
    
    % 创建图例
    legend_labels = cell(1, length(unique_labels) + 1);
    for k = 1:length(unique_labels)
        legend_labels{k} = sprintf('类别 %d', unique_labels(k));
    end
    legend_labels{end} = '区间外 (类别 -1)'; % 区间外的类别标签为 -1
    legend(legend_labels, 'Location', 'best');
    
   
    hold on;  % 保持当前图，以便后续添加图例
    legend_handles = []; % 存储每个图例的句柄
    for k = 1:2
        % 画出一个隐形的柱子用于图例
        h = bar(nan, 'FaceColor', colors(k, :));
        legend_handles = [legend_handles, h]; % 存储句柄
    end

    % 确保图例颜色和标签类别一致
    legend_entries={'舰船','渔船'};
    legend(legend_handles, legend_entries, 'Location', 'northeast');





    
    
    
    
    % 设置三维视图
    view(2); % 确保绘制的是三维散点图
    
    grid on;
    hold off;
end



 