%% 001.清空工作区间，添加工具箱至搜索路径
clc;clear;close all
addpath(genpath('Analyse-tools-YG'));

%% 002.读取原始信号及打标时刻（易格无线采集设备）
samfs = 30000;    % 采样频率
downfs = 1000;    % 降采样后频率
channel = 1:1:16;
Drawing = false;
% 读取plx原始数据文件
[plx_NAMEFile,filepath,plx_FILEIndex] = uigetfile('*.plx','Select the date file','E:\郑州平台\实验室迷宫数据之092_106_653\1.原始数据\092鸽原始数据(N)');
plx_FullFilename = strcat(filepath,plx_NAMEFile);
% 读取excel精确打标时刻
[xlsx_NAMEFile,xlsxpath,xlsx_FILEIndex] = uigetfile('*.xlsx','Select the date file',filepath);
xlsx_FullFilename = strcat(xlsxpath,xlsx_NAMEFile);
refs_temp = xlsread(xlsx_FullFilename);
refs = refs_temp(:,1:3);
% % 获取所有通道原始数据
% [allad] = readplx(plx_FullFilename,Drawing);
% rawdata=[];
% for k=1:length(channel)
%         cha=channel(k);
%         s=allad{1,cha};
%         rawdata=[rawdata,s];
% end
% % 原始数据预处理得到Spike与LFP原始信号
% Common=false;
% [rawspk,rawlfp] = f_rawdata_preprocessing(rawdata,samfs, downfs, channel,Common);

Common=false;

[rawdata,rawlfp,rawspk] = f_read_rawdata_lfp(plx_FullFilename,samfs,downfs,channel,Common,Drawing);  % 读取原始信号并筛选通道

%% 004.试次区间Spike特征分析
bin=100;
spk_thre_min = 2.9;                            % spike阈值下限
spk_thre_max = 8;                             % spike阈值上限
p_spkthre(rawspk,spk_thre_min,spk_thre_max)                                  % 显示spk原始信号，确定spk阈值
spk_raster=f_read_raster(rawspk,samfs,downfs,spk_thre_min,spk_thre_max);     % 提取raster特征 
spk_rate=f_sl_binsl(spk_raster,bin,1);
before = 1;      % 往前的时间裕量，秒
after = 1;       % 往后的时间裕量，秒
% p_spk_raster(spk_raster,channel,refs,before,downfs);
% p_spk_trial(spk_raster,spk_rate,channel,refs,before,after,downfs);

%% 005.试次区间LFP特征分析
freq = [1,150];             % 时频分析的频率范围
window=128;
step=1;
before=1;      % 往前往后的时间裕量，秒
after=3;       % 往前往后的时间裕量，秒
[data_sz,f]=f_read_lfptf(rawlfp,channel,freq,downf,window,step,refs,before,after);
% p_lfp_trial(data_sz,f,channel,refs,fband,downfs,before,after);

%% 测试
 ch_select = 6;
for i=1:size(data_sz,1)

    A = data_sz{i,ch_select};
    B= A';
    C= normalize(B);
    D= C';
    
    label=refs(i,3);
    if label==0
        target_category ='特定目标';
    elseif label==1
        target_category ='干扰目标';
    end

        
    figure('units','normalized','outerposition',[0 0 1 1],'visible','on');
    imagesc(D);
    colormap("jet")
    colorbar
    axis xy;
    hold on
    xline(before*downfs, 'r', 'LineWidth', 3.5);
    xline((refs(i,2)-refs(i,1)+before)*downfs, 'r', 'LineWidth', 3.5);
    
    xlabel('时间/秒','FontName', 'SimHei', 'FontSize', 14);
    ylabel('LFP频带','FontName', 'SimHei', 'FontSize', 14);
    title(strcat(target_category,'---','试次',num2str(i),'通道',num2str(ch_select),'频带归一化后LFP能量时频图'),'FontName', 'SimHei', 'FontSize', 26)

    ax = gca;
    % 单独设置 x 或 y 轴刻度字体
    ax.XAxis.FontSize = 15;    % x轴刻度字号
    ax.YAxis.FontSize = 15;    % y轴刻度字号

end

%% 单试次多通道

Result_RootPath = strcat(filepath, '归一化后LFP');  % 可视化图片保存路径
mkdir(Result_RootPath);
all_select_ch = 16;
for i=1:size(data_sz,1)
    label=refs(i,3);
    if label==0
        target_category ='特定目标';
    elseif label==1
        target_category ='干扰目标';
    end

    h2=figure('units','normalized','outerposition',[0 0 1 1],'visible','on');
    sgtitle(strcat(target_category,'---','试次',num2str(i),'---频带归一化后LFP能量时频图'),'FontName', 'SimHei', 'FontSize', 16)
    for ch=1:size(data_sz,2)

        subplot(4,4,ch);
        A = data_sz{i,ch};
        B= A';
        C= normalize(B);
        D= C';

        if ch==1

            trail_all_chs = zeros(size(D,1),size(D,2));
        end

        
        trail_all_chs=trail_all_chs+D;
        imagesc(D);
        colormap("jet")
        colorbar
        axis xy;
        hold on
        xline(before*downfs, 'r', 'LineWidth', 3.5);
        xline((refs(i,2)-refs(i,1)+before)*downfs, 'r', 'LineWidth', 3.5);

        xlabel('时间/秒','FontName', 'SimHei', 'FontSize', 14);
        ylabel('LFP频带','FontName', 'SimHei', 'FontSize', 14);
        title(strcat('通道',num2str(ch)),'FontName', 'SimHei', 'FontSize', 12)

    end

        %图片保存
        saved_rootpath = Result_RootPath;
        filename = strcat('Trial ',num2str(i),'-类别标签- ',target_category);
        full_savedfile_name = strcat(saved_rootpath,'\',filename,'.png');
        print(h2,'-dpng',full_savedfile_name);
        close(h2)

        % 绘制单试次多通道叠加图
        h3=figure('units','normalized','outerposition',[0 0 1 1],'visible','on');
        imagesc(trail_all_chs)
        colormap("jet")
        colorbar
        axis xy;
        hold on
        xline(before*downfs, 'r', 'LineWidth', 3.5);
        xline((refs(i,2)-refs(i,1)+before)*downfs, 'r', 'LineWidth', 3.5);

        xlabel('时间/秒','FontName', 'SimHei', 'FontSize', 14);
        ylabel('LFP频带','FontName', 'SimHei', 'FontSize', 14);
        title(strcat(target_category,'所有通道叠加-','试次',num2str(i)),'FontName', 'SimHei', 'FontSize', 12)

        % 保存叠加图
        filename = strcat('所有通道叠加-','试次-',num2str(i),target_category);
        full_savedfile_name = strcat(saved_rootpath,'\',filename,'.png');
        print(h3,'-dpng',full_savedfile_name);
        close(h3)



end



%% 005.提取LFP特征分析
fband=1:80;              % 选取的子频带
lfp_stft=f_read_lfp(rawlfp,downfs,fband);
lfp0510=squeeze(mean(lfp_stft(5:10,:,:)));
lfp0510rate=f_sl_binsl(lfp0510,200,1);
lfp3045=squeeze(mean(lfp_stft(30:45,:,:)));
lfp3045rate=f_sl_binsl(lfp3045,200,1);
lfp6080=squeeze(mean(lfp_stft(60:80,:,:)));
lfp6080rate=f_sl_binsl(lfp6080,200,1);
lfp1030=squeeze(mean(lfp_stft(10:30,:,:)));
lfp1030rate=f_sl_binsl(lfp1030,200,1);
%% 005.LFP全时长特征分析
data=lfp6080;
    % figure('units','normalized','outerposition',[0 0 1 1],'visible','on');
for ch=1:size(data,2)
    temp_ch=data(:,ch);
    figure('units','normalized','outerposition',[0 0 1 1],'visible','on');
    % subplot(4,4,ch)
    t=(0:length(temp_ch)-1)/downfs;
    plot(t,temp_ch');
    xlabel('秒');
    ylabel('LFP能量变化率');
    title(strcat('LFPrate-全时长-ch',num2str(ch)))
    % ylim([0 35000])
    hold on
    for i=1:size(refs,1)
        temp_sample_begein = refs(i,1);
        temp_sample_end = refs(i,2);
        if refs(i,3)==0
            xline(temp_sample_begein, 'r', 'LineWidth', 1.5);
            xline(temp_sample_end, 'b', 'LineWidth', 1.5);
        else
            xline(temp_sample_begein, 'g', 'LineWidth', 1.5);
            xline(temp_sample_end, 'b', 'LineWidth', 1.5);
        end

    end
    hold off
end

%% 006.单试次单通道数据可视化（试次区间内）
% 可视化图片保存路径设置
Result_RootPath=strcat(filepath,'results-单试次单通道');            
mkdir(Result_RootPath);
Channel_choose = false;      % 设定是否进行通道筛选；   true为筛选；false则不进行筛选，默认全部通道或者试次
Trail_choose = false;        % 设定是否进行试次筛选；

choose_ch=[3 6 8 9];            % 设定选取的通道
choose_trail=[2 5];             % 设定选取的试次
marking_interval=[5 5];         % [a b]，参数a为打标1时刻前多截取时间段；参数b为打标2时刻后多截取时间段
fband_Zero=[5 10];
fband_One=[30 45];
fband_Two=[60 80];

downfs=1000;
p_showtrial(rawdata,rawspk,rawlfp,spk_rate,lfp0510,lfp3045,lfp6080,refs, marking_interval, fband_Zero, fband_One,fband_Two,samfs,downfs,choose_trail,choose_ch,Result_RootPath,Channel_choose,Trail_choose)

%% 007.单试次多通道与单通道多试次（试次区间内）
Result_RootPath = strcat(filepath, 'results-单试次多通道3');  % 可视化图片保存路径
mkdir(Result_RootPath);
Channel_choose = false;  % 设定是否进行通道筛选；true为筛选；false则不进行筛选，默认全部通道或者试次
Trail_choose = false;    % 设定是否进行试次筛选

choose_ch = 1:16;  % 设定选取的通道
choose_trail = 1:size(refs,1);   % 设定选取的试次
marking_interval = [1 3];  % [a b]，参数a为打标1时刻前多截取时间段；参数b为打标2时刻后多截取时间段
fband_One = [30 45];
fband_Two = [60 80];
downfs = 1000;
% 检查choose_trail是否在refs的有效范围内
num_trials = size(refs, 1);
choose_trail = choose_trail(choose_trail <= num_trials);

% 遍历每个试次，并绘制图像
for i = 1:length(choose_trail)
    plot_trial_multiple_channels(rawspk, rawlfp, spk_rate, lfp3045, lfp6080, refs, marking_interval, fband_One, fband_Two,samfs, downfs, choose_trail, choose_ch, Result_RootPath, i);
end

Result_RootPath = strcat(filepath, 'results-单通道多试次3');  % 可视化图片保存路径
mkdir(Result_RootPath);
% 遍历每个通道，并绘制图像
for ch = choose_ch
    plot_channel_multiple_trials(rawspk, rawlfp, spk_rate, lfp3045, lfp6080, refs, marking_interval, fband_One, fband_Two,samfs, downfs, choose_trail, ch, Result_RootPath);
end

%% 试次内相关性计算(试次区间内)
Result_RootPath = strcat(filepath, 'results-试次内相关性');  % 可视化图片保存路径
mkdir(Result_RootPath);
% 滑窗窗长设定
window_length = 0.2;     %单位/秒
before=2;   %试次向前
after=5;
f_corr_trial(spk_rate, downfs, window_length, refs, before, after,Result_RootPath)


%% 试次内降维聚类
window_length = 0.01;     %单位/秒
all_trial_data=f_pca_trial(lfp6080, downfs, window_length, refs);

%% PCA降维聚类（全时长）
% 滑窗窗长设定
window_length = 0.6;     %单位/秒
f_PCA_allData(lfp6080rate, downfs, window_length, refs);

%% 20s特征图

data=lfp6080rate;
Result_RootPath=strcat(filepath,'lfp6080rate-60');            % 可视化图片保存路径
mkdir(Result_RootPath);


% 设置采样率和段长度
fs = 1000;  % 采样率，单位为 Hz
segment_length_sec = 60;  % 每段的时间长度，单位为秒

% 计算段长度对应的数据点数
segment_length_points = fs * segment_length_sec;

% 计算总点数和段数
num_points = size(data, 1);
num_segments = ceil(num_points / segment_length_points);  % 使用 ceil 以确保包含最后一个不完整的段（如果有）

% 预处理时间戳（整个数据集的时间戳）
total_time_stamps = (0:num_points-1) / fs;  % 计算整个数据集的时间戳，单位为秒

% 计算打标位置

refs_position = refs(:,1)';


% 循环遍历每个段并绘制
for segment_idx = 1:num_segments
    % 计算当前段的起始和结束索引（注意：这里使用 round 以确保索引是整数）
    start_idx = round((segment_idx - 1) * segment_length_points) + 1;
    end_idx = min(round(segment_idx * segment_length_points), num_points);
    
    % 提取当前段的数据
    segment_data = data(start_idx:end_idx, :);
    
    % 计算当前段的时间戳（绝对时间）
    segment_time_stamps = total_time_stamps(start_idx:end_idx);

    h_Fig=figure('units','normalized','outerposition',[0 0 1 1],'Visible','on');
    title(sprintf('Spike Rate for %d-%d s Segment - Segment %d', ...
        start_idx/fs, end_idx/fs-1/fs, segment_idx));  % 设置图形标题，显示绝对时间范围
    
    % 绘制每个通道的数据
    for channel_idx = 1:size(segment_data, 2)
        % 使用 subplot 创建 8x2 的网格布局，并定位到当前通道的子图
        subplot(8, 2, channel_idx);
        
        % 绘制当前通道的数据
        plot(segment_time_stamps, segment_data(:, channel_idx)');

        hold on;

        for i = 1:length(refs_position)
            line_time = refs_position(i);

            if line_time >= start_idx/fs && line_time <= end_idx/fs

                line_idx = round(line_time,3);

                if refs(i,3)==0
                    plot([line_idx,line_idx],ylim,'r','LineWidth',1.5)    %绘制spike阈值下线（红色）
                    hold off;
                else
                    plot([line_idx,line_idx],ylim,'g','LineWidth',1.5)    %绘制spike阈值下线（红色）
                end


            end
        end


        
        % 设置轴标签和标题
        if channel_idx == 1 || mod(channel_idx-1, 8) == 0
            xlabel('Time (s)');  % 每行的第一个子图设置X轴标签
        else
            xlabel('');  % 其他子图不显示X轴标签
        end
        ylabel('LFP Rate');  % 设置Y轴标签
        title(sprintf('Channel %d', channel_idx));  % 设置子图标题
        % 
        % 设置Y轴范围（可选，但有助于可视化）
        % ylim(- max(segment_data(:, channel_idx)) * 1.1);
        % ylim([-600 600]);
        hold on
    end
    
    % 可选：添加图形网格线
    grid on;
    
    % 可选：保存图形到文件（如果需要）
    % saveas(gcf, sprintf('segment_%d.png', segment_idx));


    saved_rootpath =Result_RootPath;
    filename=num2str(segment_idx);
    full_savedfile_name = strcat(saved_rootpath,'\',filename,'.png');
    print(h_Fig,'-dpng',full_savedfile_name);
    close(h_Fig)


end

% 提示用户处理完成
disp('Processing complete. All segments have been plotted with absolute time on the X-axis.');




