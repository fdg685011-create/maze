window=256;
step=1;
before=1;      % 往前往后的时间裕量，秒
after=3;
[data_sz,f]=f_read_lfptf(sign_lfp_raw,channel,freq,downfs,window,step,refs,before,after);
% lfp发放率，全时间段
fband=[60,80];              % 选取的子频带
